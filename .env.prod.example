# ==============================================================================
# ECHORA — CONFIGURAÇÕES DE PRODUÇÃO (PROD)
# ==============================================================================
# NUNCA versione o arquivo final com valores reais.
# Gere chaves criptográficas fortes usando: openssl rand -base64 32
# Defina APP_ENV=production no ambiente do processo para carregar .env.prod da raiz.

# --- Aplicação & Ambiente ---
APP_ENV=production
DEBUG=false
PROJECT_NAME="Echora Sentiment API"
API_VERSION="0.2.0"

# --- Banco de Dados (PostgreSQL Obrigatório em Produção) ---
# O sistema bloqueia o boot se tentar usar SQLite quando APP_ENV=production.
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://echora_app:SENHA_URL_ENCODED@postgres:5432/echora

# --- CORS (Apenas domínios reais de produção) ---
CORS_ORIGINS="https://echora.caueti.com"

# --- Segurança & Autenticação ---
# Chave secreta de alta entropia para assinatura dos JWTs:
# Gere com: openssl rand -hex 64
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_HEX_ALEATORIA_DE_64_CARACTERES
JWT_ALGORITHM="HS256"
JWT_ISSUER="echora"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Criptografia dos Feedbacks (AES-256-GCM) ---
# Chave simétrica aleatória de exatamente 256 bits (32 bytes) em Base64.
# Deve ser diferente da SECRET_KEY. Preserve a chave usada nos dados existentes:
# alterá-la sem migrar os feedbacks impede a descriptografia desses registros.
# OBRIGATÓRIA em produção:
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_32_BYTES

# --- Rate Limit (Proteção contra Abuso / DoS) ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STORAGE_URI=redis://:SENHA_URL_ENCODED@redis:6379/0

# --- Modelo de Sentimento (ONNX Local ou Servidor Dedicado) ---
# Caso rode o ONNX no próprio container/servidor:
SENTIMENT_MODEL_PATH="models/model.onnx"
# Caso utilize um microserviço/VM remota para inferência ONNX:
SENTIMENT_API_URL=""
SENTIMENT_API_KEY=""

# --- IA / Sumário com LLM (OpenAI) ---
SUMMARY_PROVIDER="openai"
SUMMARY_MODEL="gpt-5-nano"
# Relatório Executivo: requisições por usuário por hora.
SUMMARY_ADMIN_REQUESTS_PER_HOUR=3
# Limites para a primeira e a segunda tentativa, incluindo raciocínio e texto.
SUMMARY_OPENAI_MAX_COMPLETION_TOKENS=512
SUMMARY_OPENAI_RETRY_MAX_COMPLETION_TOKENS=1024
OPENAI_API_KEY=sk-proj-SUA_CHAVE_PRODUCAO_OPENAI_AQUI
OPENAI_API_BASE="https://api.openai.com/v1"

# --- Logs ---
LOG_DIR="/app/logs"
