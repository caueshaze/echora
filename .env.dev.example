# ==============================================================================
# ECHORA — CONFIGURAÇÕES DE DESENVOLVIMENTO (DEV)
# ==============================================================================
# Copie este arquivo para ".env" para rodar localmente:
# cp .env.dev.example .env

# --- Aplicação & Ambiente ---
APP_ENV=development
DEBUG=true
PROJECT_NAME="Echora Sentiment API (Dev)"
API_VERSION="0.2.0"

# --- Banco de Dados ---
# Para desenvolvimento local rápido, SQLite funciona automaticamente:
DATABASE_URL=sqlite:///./echora.db
# Caso prefira testar com PostgreSQL local via Docker/Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/echora_dev

# --- CORS (Permissões de Origem para Frontend) ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Segurança & Autenticação ---
SECRET_KEY="dev-insecure-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ISSUER="echora"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Criptografia dos Feedbacks (AES-256-GCM) ---
# Em dev, se deixado vazio, deriva automaticamente da SECRET_KEY.
# Você pode gerar uma chave segura de 32 bytes em base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# --- Rate Limit (Controle de Requisições) ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Modelo de Sentimento Local (ONNX) ---
SENTIMENT_MODEL_PATH="models/model.onnx"

# --- IA / Sumário com LLM (OpenAI) ---
SUMMARY_PROVIDER="openai"
SUMMARY_MODEL="gpt-5-nano"
# Relatório Executivo: requisições por usuário por hora.
SUMMARY_ADMIN_REQUESTS_PER_HOUR=3
MAYA_DAILY_QUESTION_LIMIT=5
# Limites para a primeira e a segunda tentativa, incluindo raciocínio e texto.
SUMMARY_OPENAI_MAX_COMPLETION_TOKENS=512
SUMMARY_OPENAI_RETRY_MAX_COMPLETION_TOKENS=1024
OPENAI_API_KEY="sk-proj-sua-chave-aqui"
OPENAI_API_BASE="https://api.openai.com/v1"

# --- Logs ---
LOG_DIR="logs"
