# ==============================================================================
# ECHORA — ARQUIVO DE EXEMPLO BASE
# ==============================================================================
# Para configurações detalhadas, consulte:
# - .env.dev.example   (Ambiente de desenvolvimento / local)
# - .env.prod.example  (Ambiente de produção / nuvem)

APP_ENV=development
DEBUG=true
PROJECT_NAME="Echora Sentiment API"
API_VERSION="0.2.0"

# Banco de dados
DATABASE_URL=sqlite:///./echora.db

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Autenticação & Criptografia
SECRET_KEY="dev-insecure-secret-key-change-in-production"
DATA_ENCRYPTION_KEY=""
# Chave Base64 de 32 bytes independente; necessária para hmac-v2.
MAYA_IDEMPOTENCY_HMAC_KEY=""
MAYA_IDEMPOTENCY_WRITE_VERSION="legacy-v1"

# Modelo e IA
SENTIMENT_MODEL_PATH="models/model.onnx"
SUMMARY_PROVIDER="openai"
SUMMARY_MODEL="gpt-5-nano"
SUMMARY_ADMIN_REQUESTS_PER_HOUR=3
MAYA_DAILY_QUESTION_LIMIT=5
# Os limites incluem tokens de raciocínio e de texto gerado.
SUMMARY_OPENAI_MAX_COMPLETION_TOKENS=512
SUMMARY_OPENAI_RETRY_MAX_COMPLETION_TOKENS=1024
OPENAI_API_KEY=""
